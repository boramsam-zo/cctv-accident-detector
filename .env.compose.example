# Team local full-stack Compose. Copy to .env; never commit filled credentials.
# The containers set DATABASE_URL and BACKEND_API_URL themselves.
POSTGRES_PASSWORD=cctv_local
APP_API_KEY=local-dev-only
S3_BUCKET=
# Replace YOUR_NAME with a unique teammate namespace.
S3_KEY_PREFIX=dev/YOUR_NAME/
AWS_REGION=ap-northeast-2
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required when using temporary AWS credentials; otherwise leave blank.
AWS_SESSION_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Leave empty to use only GEMINI_MODEL, or list account-enabled models.
GEMINI_MODELS=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=dev
MODAL_APP_NAME=cctv-accident-inference
MODAL_FUNCTION_NAME=analyze_video_job
ANALYSIS_PROFILE_ID=received-yolo-x3ds-v1
MAX_UPLOAD_BYTES=104857600
MAX_GEMINI_CLIP_BYTES=18874368
MAX_MODEL_WEIGHT_BYTES=536870912
RAG_ENABLED=true
RAG_STORE=postgres
RAG_CORPUS_VERSION=
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.35
# Needed for Compose interpolation; MLflow is not started by the local launcher.
MLFLOW_ARTIFACT_PREFIX=dev/local/mlflow/
