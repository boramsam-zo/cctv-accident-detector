# Copy to .env for local use. Never commit populated secrets.
# Load these values in both API and enrichment worker shells.
APP_API_KEY=
POD_WORKER_TOKEN=
# Local compose: postgresql+psycopg://cctv:cctv_local@127.0.0.1:5433/cctv
DATABASE_URL=sqlite:///./backend.db
# Required by deploy/compose/compose.yaml; use a URL-safe password for this dev setup.
POSTGRES_PASSWORD=
# EC2/shared DB example: postgresql+psycopg://user:password@host:5432/cctv
BACKEND_API_URL=http://127.0.0.1:8000
S3_BUCKET=
# Optional namespace inside a shared bucket, for example dev/alice
S3_KEY_PREFIX=
AWS_REGION=ap-northeast-2
# Optional S3-compatible endpoint for local testing; blank for AWS S3.
S3_ENDPOINT_URL=
# Local S3 test server: S3_BUCKET=cctv-local, S3_ENDPOINT_URL=http://127.0.0.1:5000,
# AWS_ACCESS_KEY_ID=local, AWS_SECRET_ACCESS_KEY=local
# Leave blank when using an EC2 instance role or a local AWS profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Modal SDK credentials are configured with `modal token new` or MODAL_TOKEN_ID/
# MODAL_TOKEN_SECRET in the backend and worker environment. Never commit them.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=dev
MODAL_APP_NAME=cctv-accident-inference
MODAL_FUNCTION_NAME=analyze_video_job
# Set these in Modal's cctv-s3 Secret, not only in this local .env:
# MODEL_WEIGHTS_S3_BUCKET=cctv-model-weights-bucket
# X3D_WEIGHTS_S3_KEY=models/x3d_s/best.pt
# YOLO_WEIGHTS_S3_KEY=models/yolo11s/best.pt
# X3D_WEIGHTS_SHA256=<64-character SHA256 of best_model.pt>
# YOLO_WEIGHTS_SHA256=<64-character SHA256 of best.pt>

ANALYSIS_PROFILE_ID=received-yolo-x3ds-v1
MAX_UPLOAD_BYTES=104857600
MAX_GEMINI_CLIP_BYTES=18874368
WORKER_LEASE_SECONDS=60
