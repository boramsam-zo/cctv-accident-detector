# Local development only. Bind FastAPI and Streamlit to 127.0.0.1.
APP_API_KEY=local-dev-only
# Moto S3 is only for frontend/API development. Modal needs a real AWS S3 bucket.
BACKEND_API_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+psycopg://cctv:cctv_local@127.0.0.1:5433/cctv
S3_BUCKET=cctv-local
S3_ENDPOINT_URL=http://127.0.0.1:5000
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANALYSIS_PROFILE_ID=received-yolo-x3ds-v1
MODAL_ENVIRONMENT=dev
MODAL_APP_NAME=cctv-accident-inference
MODAL_FUNCTION_NAME=analyze_video_job
